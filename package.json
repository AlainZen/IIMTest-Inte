{
  "name": "pokewishlist",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:locales": "node scripts/check-locales.mjs app/locales",
    "check:static": "node scripts/check-static.mjs .output/public",
    "check:seo": "node scripts/check-seo.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
